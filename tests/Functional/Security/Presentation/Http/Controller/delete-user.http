###
# First execute login.http to set auth_token
###

###
# WIll succeed if id is in the database
DELETE {{host}}{{api}}/users/80cfa1c5-e0f9-44ff-83ab-c4269cd9a741
Accept: application/json
Authorization: Bearer {{auth_token}}

###
# 2nd run will fail, 404

DELETE {{host}}{{api}}/users/80cfa1c5-e0f9-44ff-83ab-c4269cd9a741
Accept: application/json
Authorization: Bearer {{auth_token}}

###
# will fail, 400
DELETE {{host}}{{api}}/v1/users/the_user
Accept: application/json
Authorization: Bearer {{auth_token}}
